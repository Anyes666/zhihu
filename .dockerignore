# Default deny: send only reviewed runtime source and public assets to Docker.
**
!Dockerfile
!.dockerignore
!package.json
!server.mjs
!lib/
!lib/*.mjs
!data/
!data/characters.mjs
!data/letters/
!data/letters/*.mjs
!data/demo/
!data/demo/*.json
!public/
!public/*.html
!public/*.css
!public/*.js
!public/assets/
!public/assets/*.jpg
!public/assets/*.png
!public/assets/portraits/
!public/assets/portraits/*.png

# Defense in depth: no credentials, caches, or accounting data.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm
**/*.db
**/*.log
data/cache/
data/budget/
