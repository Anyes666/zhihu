# 回声邮局 · 环境变量示例
# 默认无实时预算也能完成游戏：规则引擎 + 已有缓存/演示资料。知识联网同样需批准预算。
# npm start 不自动读取 .env。可在进程环境注入，或 Node 24+ 用：
# node --env-file=.env server.mjs
# 不要把密钥提交到仓库、写入浏览器代码或分享截图。

# 知乎数据能力的 Access Secret。配置不代表请求已成功，实际看来源标签。
ZHIHU_ACCESS_SECRET=
# false 关闭知识上游请求（已有缓存仍可读取）。
ZHIHU_KNOWLEDGE_ENABLED=true
# 可选缓存目录，默认 data/cache。
ZHIHU_CACHE_DIR=

# 生成模型供应商：deepseek / openai / zhida / none。
# 显式选择 DeepSeek 后，添加知乎凭据不会抢占生成路径。
# DeepSeek 未设 BASE_URL 时使用 https://api.deepseek.com。
LLM_PROVIDER=deepseek
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-flash

PORT=3000
HOST=127.0.0.1

# 仅重新生成美术资源时需要；游戏运行不需要。
XXAPI_KEY=

# ===== API 预算保护（服务端、需要重启生效） =====
# 默认关闭所有新的实时 API 请求；不影响规则游戏、缓存和演示资料。
# 只有明确批准预算后才设 true。不要把测试脚本的高额度复制到生产环境。
API_LIVE_ENABLED=false
# 必须持久化。Docker 将宿主机目录挂载到 /app/data/budget；所有同实例进程用同一账本。
# 留空默认 data/budget/ledger.sqlite。不要删除账本或更换路径来排障，那会失去累计计数。
API_BUDGET_DB=
# 本地日期按 Asia/Shanghai；TOTAL 是该账本自创建以来的累计，不随每日或重启清零。
# 0 = 不放行。以下不是你的官方余额，不会自动批准消费。
API_LLM_DAILY_CALLS=0
API_LLM_TOTAL_CALLS=0
# 本地保守预留单位 = 序列化输入UTF-8字节数 + 最大输出Token + 1024。
# 非供应商准确Token/账单金额，不是人民币预算。失败/超时保留整笔预留，不退款。
API_LLM_DAILY_UNITS=0
API_LLM_TOTAL_UNITS=0
API_HOT_DAILY_CALLS=0
API_HOT_TOTAL_CALLS=0
API_SEARCH_DAILY_CALLS=0
API_SEARCH_TOTAL_CALLS=0
API_KNOWLEDGE_DAILY_CALLS=0
API_KNOWLEDGE_TOTAL_CALLS=0
# 单次模型保护；没有预算仍不会调用。max_tokens 已核对 DeepSeek 官方文档。
API_LLM_MAX_OUTPUT_TOKENS=800
API_LLM_MAX_INPUT_BYTES=24000
# 所有类型合计并发；同一玩家、同一类型最多1个在途请求。
API_MAX_CONCURRENT=3
# 跨游戏局累计的匿名玩家/IP限制；不是只限制每局。
API_LLM_PLAYER_DAILY_CALLS=6
API_LLM_IP_DAILY_CALLS=60
API_SEARCH_PLAYER_DAILY_CALLS=3
API_SEARCH_IP_DAILY_CALLS=100
API_PLAYER_PER_MINUTE=6
API_IP_PER_MINUTE=30
# HTTPS部署时设true；Cookie为HttpOnly/SameSite=Lax，无API Key。
API_SECURE_COOKIE=false
# 默认不相信X-Forwarded-For；只填直接连接后端且正确追加/重写来源头的代理IP（逗号分隔）。
API_TRUSTED_PROXY_IPS=
